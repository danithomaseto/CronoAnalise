{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["js/core/**/*.js", "js/config.js"]
}
